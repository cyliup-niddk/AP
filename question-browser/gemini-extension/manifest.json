{
  "manifest_version": 3,
  "name": "Physics Question → Gemini Unit",
  "version": "1.1.0",
  "description": "Classify local AP Physics questions in Gemini and save unit numbers to your SQLite library.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Open question classifier"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "response-parser.js",
        "gemini.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
